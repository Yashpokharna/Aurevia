# ─────────────────────────────────────────────────────────────
# Store admin
# ─────────────────────────────────────────────────────────────
# /admin stays locked until this is set. Use something long.
ADMIN_PASSWORD=
# Optional: signs the admin session cookie. Defaults to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# ─────────────────────────────────────────────────────────────
# Branding
# ─────────────────────────────────────────────────────────────
# The address shown in the footer and on every "contact us" link.
NEXT_PUBLIC_CONTACT_EMAIL=hello@aurevia.com
# Indicative rate — only used to suggest a USD price in the admin form.
NEXT_PUBLIC_INR_PER_USD=88

# ─────────────────────────────────────────────────────────────
# Payments — India (INR) via Razorpay
# dashboard.razorpay.com → Settings → API Keys
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → add https://yourdomain.com/api/webhooks/razorpay
# Subscribe to: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Payments — US and rest of world (USD) via Stripe
# dashboard.stripe.com → Developers → API keys
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Developers → Webhooks → add https://yourdomain.com/api/webhooks/stripe
# Subscribe to: checkout.session.completed, checkout.session.async_payment_failed
# Locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Optional: route a currency to the other gateway (razorpay | stripe)
# GATEWAY_INR=razorpay
# GATEWAY_USD=stripe

# ─────────────────────────────────────────────────────────────
# Geo / currency
# ─────────────────────────────────────────────────────────────
# No geo header exists locally. Set this to test the other side.
# DEV_COUNTRY=IN
# Fallback when a real visitor's country can't be determined.
DEFAULT_COUNTRY=US

# ─────────────────────────────────────────────────────────────
# Uploads
# ─────────────────────────────────────────────────────────────
# MAX_IMAGE_BYTES=15728640
# MAX_VIDEO_BYTES=104857600
